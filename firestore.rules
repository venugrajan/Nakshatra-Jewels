rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Settings (Security PIN)
    match /settings/security {
      allow read: if true;
      allow write: if isSignedIn(); 
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn(); // Logic for PIN will be in UI for now
    }

    // Subcategories
    match /subcategories/{subId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Sub-sub-categories
    match /subsubcategories/{ssId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
