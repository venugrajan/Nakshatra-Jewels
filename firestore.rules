rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Settings (Security PIN)
    match /settings/security {
      allow read: if true;
      allow write: if isSignedIn(); 
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Subcategories
    match /subcategories/{subId} {
      allow read: if true;
      allow write: if true;
    }

    // Sub-sub-categories
    match /subsubcategories/{ssId} {
      allow read: if true;
      allow write: if true;
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
